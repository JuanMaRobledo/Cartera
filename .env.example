# Cadena de conexión a una base Postgres (por ejemplo de https://neon.tech, plan gratuito).
DATABASE_URL="postgresql://usuario:password@host/basededatos?sslmode=require"

# Credenciales para acceder a la aplicación. APP_USERNAME es opcional y usa
# JuanMaRobledo si se omite; APP_PASSWORD debe configurarse en producción.
APP_USERNAME="JuanMaRobledo"
APP_PASSWORD="cambia-esta-contrasena"
